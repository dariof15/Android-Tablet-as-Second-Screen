# Copy to .env and edit. Every value here is the built-in default, so an empty
# .env behaves exactly like no .env at all.
#
#   precedence: command-line flag > environment variable > .env > default
#
# Changes take effect on restart:
#   systemctl --user restart tablet-screen tablet-screen-layout tablet-screen-tunnel

# ---------------------------------------------------------------- resolution --
# Size of the virtual monitor, in pixels. This is what gets encoded, so it is
# the main performance and sharpness dial. Match your tablet's aspect ratio to
# avoid black bars: 1536x1024 is 3:2, like a 3200x2136 panel.
SCREEN_WIDTH=1536
SCREEN_HEIGHT=1024

# Frame rate cap. Frames are only produced when the screen changes, so this is
# a ceiling and not a constant cost.
SCREEN_FPS=30

# ------------------------------------------------------------------- quality --
# JPEG quality, 0-100. 95 is visually lossless for desktop content; 98 is
# sharper for a few more KB per frame; below ~85 text starts to soften.
JPEG_QUALITY=95

# software = CPU, 4:4:4 chroma, best colour (~12 ms/frame at 1536x1024)
# hw       = Intel iGPU, 4:2:2 chroma, ~3.7 ms/frame but measurably worse colour
#            (mean channel error 7.3 vs 0.45). Use it if CPU matters more.
ENCODER=software

# ----------------------------------------------------------------- transport --
# Port served on the PC and reverse-tunnelled to the same port on the tablet.
HTTP_PORT=8099

# Listen address. Keep 127.0.0.1: the stream is unencrypted and unauthenticated,
# and the USB tunnel does not need anything else. Only change this if you
# deliberately want it on your LAN and accept that anyone there can watch.
HTTP_BIND=127.0.0.1

# Seconds to keep the virtual monitor alive after the last viewer disconnects,
# so reloading the page does not tear the screen down and rearrange your windows.
IDLE_GRACE=8

# ------------------------------------------------------------------- display --
# Which side of the built-in screen the tablet sits on: left or right.
MONITOR_SIDE=left

# Scale factor for the virtual monitor. 1 is native; 2 gives a HiDPI-style
# desktop at half the logical size. Fractional values need GNOME's fractional
# scaling enabled.
MONITOR_SCALE=1

# Connector prefix of your built-in panel, used to position the tablet relative
# to it. Laptops are normally eDP-; on a desktop use your primary output's
# connector prefix, e.g. DP- or HDMI-.
BUILTIN_CONNECTOR=eDP-

# Write the arrangement into ~/.config/monitors.xml (1) or apply it only for the
# current session (0). Leave this at 0: Mutter gives every virtual monitor a new
# serial, so a persistent write adds a stanza that can never match again and the
# file grows on every connect.
LAYOUT_PERSIST=0

# ----------------------------------------------------------------------- adb --
# Pin to one device when several are plugged in (see: adb devices).
# Empty means "the first device that shows up".
ADB_SERIAL=

# Keep the tablet's screen from sleeping while it is plugged in (1) or leave the
# tablet's own timeout alone (0).
KEEP_AWAKE=1
